#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.
#
# Release prep, run once per release to production: reset the Neon 'preview'
# branch, set the dev-scoped Preview variables, migrate, UAT, then the owner's
# production steps. Spec: #179, amended; decision: #181. See the publish runbook.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=6
cd "$(dirname "${BASH_SOURCE[0]}")/.."  # repo root: package.json, .vercel/ and ENV_FILE are relative to it
ENV_FILE=".env.wizard-release-prep"  # gitignored (matches .env.*); caches non-secret picks only
NEON_PROFILE="${NEON_PROFILE:-scd}"

# Every Preview variable, all scoped to git branch dev (#181).
PREVIEW_ENV_NAMES=(DATABASE_URL AUTH_URL AUTH_SECRET AUTH_EMAIL_SERVER AUTH_EMAIL_FROM CURRENT_SEASON)
VERCEL_CHANGED=false        # a deployment reads variables only when it's built
PREVIEW_ACTION="not reset"  # these three feed the UAT record
PREVIEW_MIGRATED="no"
UAT_LINES=()
UAT_GAPS=0

# _mask_conn hides the password in a postgres connection string, for display only.
_mask_conn() { printf '%s' "$1" | sed -E 's#(://[^:/]+:)[^@]*(@)#\1****\2#'; }

# seed_default KEY VALUE writes VALUE only if KEY has no line in ENV_FILE yet,
# so a later ask() offers it as the default without clobbering a prior answer.
seed_default() {
  local key="$1" value="$2"
  [[ -f "$ENV_FILE" ]] && grep -qE "^${key}=" "$ENV_FILE" && return 0
  write_env "$key" "$value" >/dev/null
}

# _branches reads `neon branches list -o json` as a stream of branches,
# whichever shape the CLI returns.
_branches() { jq -c 'if type == "array" then .[] else .branches[] end'; }

# _env_meta lists the project's Vercel variables as key, target and git branch.
# Values are dropped here, so none reaches the terminal or a file.
_env_meta() { vercel env ls --format json 2>/dev/null | jq -c '[.envs[] | {key, target, gitBranch}]'; }

# _has_env KEY BRANCH: KEY is set on Preview alone for git branch BRANCH, where
# "" means Preview as a whole. Reads $ENV_META.
_has_env() {
  jq -e --arg k "$1" --arg b "$2" \
    '.[] | select(.key == $k and (.target // []) == ["preview"] and ((.gitBranch // "") == $b))' \
    <<<"$ENV_META" >/dev/null 2>&1
}

# _shared_targets KEY prints the targets of any record that puts KEY on Preview
# together with Production or Development, or nothing. vercel env rm deletes a
# whole record, so removing one of these would take KEY off those too.
_shared_targets() {
  jq -r --arg k "$1" \
    '[.[] | select(.key == $k and any((.target // [])[]; . == "preview") and ((.target // []) | length) > 1)
       | .target | join(", ")] | join("; ")' \
    <<<"$ENV_META"
}

# _want_dev_var NAME: true when NAME needs setting on dev, because it's absent
# or the operator chooses to replace it.
_want_dev_var() {
  _has_env "$1" dev || return 0
  note "$1 is already set on Preview for dev"
  confirm "Replace it?"
}

# _add_dev_var NAME VALUE [flags] sets NAME on Preview for git branch dev only.
# The value goes in on stdin, never argv, so it stays out of ps and history.
_add_dev_var() {
  local name="$1" value="$2" force=""
  shift 2
  _has_env "$name" dev && force="--force"
  if printf '%s' "$value" | vercel env add "$name" preview dev "$@" ${force:+"$force"} --yes >/dev/null; then
    VERCEL_CHANGED=true
    printf '  %s✓ set%s %s on Preview, branch dev\n' "$GREEN" "$RESET" "$name"
  else
    SKIPPED+=("Vercel $name on Preview for dev (vercel env add $name preview dev)")
    warn "couldn't set $name on Preview for dev; set it later"
  fi
}

# _record_uat_gap "label" records a gap in the UAT record and the closing summary.
_record_uat_gap() {
  UAT_LINES+=("- GAP: $1")
  UAT_GAPS=$((UAT_GAPS + 1))
  SKIPPED+=("UAT gap: $1")
}

# _uat_check "label" "question" asks whether a UAT check passed and records it.
_uat_check() {
  if confirm "$2"; then
    UAT_LINES+=("- pass: $1")
  else
    _record_uat_gap "$1"
  fi
}

# _print_uat_record prints the UAT record flush left, ready to paste into the
# release PR as Markdown.
_print_uat_record() {
  local line
  printf '\n  %sUAT record: paste into the release PR (dev → main)%s\n\n' "$BOLD" "$RESET"
  printf '### UAT: dev preview, %s\n\n' "$(date +%F)"
  printf -- '- preview branch: %s\n' "$PREVIEW_ACTION"
  printf -- '- preview migrated: %s\n' "$PREVIEW_MIGRATED"
  if (( ${#UAT_LINES[@]} )); then
    for line in "${UAT_LINES[@]}"; do printf '%s\n' "$line"; done
  fi
  (( UAT_GAPS )) || printf -- '- gaps: none\n'
  printf '\n'
}

banner "Release prep: reset preview, dev variables, migrate, UAT, release"
say "Run once per release to production (#179, decided in #181). Six stages:"
say "the Neon club-account profile, a fresh 'preview' branch, the dev-scoped"
say "Preview variables, the preview migration, UAT on the dev preview, and"
say "the production owner steps."

# ── Stage 1: Neon club-account profile ────────────────────────────────────
stage "Neon: club-account profile"
say "The results database lives under the club's Neon account"
say "(admin@scdescenders.com), not your personal Neon login. It needs its own"
say "CLI profile, '$NEON_PROFILE', separate from DEFAULT."

# Creating a profile signs in through the browser, so the warning comes first.
step "If neon signs you in, your default browser may already be signed in as"
step "your personal account. If so, open a private/incognito window at the URL"
step "it prints and sign in there instead, as admin@scdescenders.com."

if neon profile list -o json 2>/dev/null | jq -e --arg n "$NEON_PROFILE" \
    '.[] | select(.name == $n)' >/dev/null 2>&1; then
  note "profile '$NEON_PROFILE' already exists"
else
  if confirm "Create Neon CLI profile '$NEON_PROFILE' for the club account?"; then
    neon profile create "$NEON_PROFILE" --keyring
  else
    warn "can't continue without it — re-run this wizard when ready"
    exit 1
  fi
fi

# Sign in again only when the profile has no session or the wrong account.
say "Confirming identity:"
if ! { neon me --profile "$NEON_PROFILE" && confirm "Does that show admin@scdescenders.com?"; }; then
  pause "Ready to sign the '$NEON_PROFILE' profile in again?"
  neon auth --profile "$NEON_PROFILE" --keyring
  neon me --profile "$NEON_PROFILE" || true
  if ! confirm "Does that show admin@scdescenders.com now?"; then
    warn "wrong identity on '$NEON_PROFILE' — fix it (neon profile remove $NEON_PROFILE, then re-run) before continuing"
    exit 1
  fi
fi

say "Projects visible to this profile:"
neon projects list --profile "$NEON_PROFILE"
ask NEON_PROJECT_ID "Paste the results project's id from the list above:"
write_env NEON_PROJECT_ID "$NEON_PROJECT_ID"

# ── Stage 2: reset the preview branch from production ─────────────────────
stage "Neon: reset the preview branch from production"
say "Preview deployments and pre-release migrations land on a dedicated"
say "'preview' branch, copy-on-write from production and never production"
say "itself. Every release starts from a fresh copy, so this stage resets it."

seed_default NEON_PARENT_BRANCH "production"
ask NEON_PARENT_BRANCH "Branch that 'preview' copies from:"
write_env NEON_PARENT_BRANCH "$NEON_PARENT_BRANCH"

BRANCHES=$(neon branches list --profile "$NEON_PROFILE" --project-id "$NEON_PROJECT_ID" -o json | _branches)
PARENT_ID=$(jq -r --arg n "$NEON_PARENT_BRANCH" 'select(.name == $n) | .id' <<<"$BRANCHES")
PREVIEW_ID=$(jq -r 'select(.name == "preview") | .id' <<<"$BRANCHES")
PREVIEW_PARENT_ID=$(jq -r 'select(.name == "preview") | .parent_id // empty' <<<"$BRANCHES")

if [[ -z "$PARENT_ID" ]]; then
  warn "no branch named '$NEON_PARENT_BRANCH' in project $NEON_PROJECT_ID — re-run and pick the right one"
  exit 1
fi

if [[ -z "$PREVIEW_ID" ]]; then
  say "There's no 'preview' branch yet."
  if confirm "Create Neon branch 'preview' from '$NEON_PARENT_BRANCH'?"; then
    # --no-secrets keeps the new branch's connection string off the screen.
    neon branches create --profile "$NEON_PROFILE" --project-id "$NEON_PROJECT_ID" \
      --name preview --parent "$NEON_PARENT_BRANCH" --no-secrets
    PREVIEW_ACTION="created from $NEON_PARENT_BRANCH"
  else
    warn "can't continue without a preview branch — re-run this wizard when ready"
    exit 1
  fi
elif [[ "$PREVIEW_PARENT_ID" != "$PARENT_ID" ]]; then
  # A reset copies the branch's own parent, so the wrong parent means the wrong copy.
  warn "'preview' wasn't branched from '$NEON_PARENT_BRANCH', so a reset would copy the wrong branch"
  warn "delete 'preview' in the Neon console, then re-run; this wizard recreates it"
  exit 1
else
  say "A reset replaces everything on 'preview' with a fresh copy of"
  say "'$NEON_PARENT_BRANCH'. Anything left from the last release is discarded."
  if confirm "Reset 'preview' from '$NEON_PARENT_BRANCH' now?"; then
    neon branches reset preview --profile "$NEON_PROFILE" --project-id "$NEON_PROJECT_ID" --parent
    PREVIEW_ACTION="reset from $NEON_PARENT_BRANCH"
  else
    warn "every release starts from a fresh copy — re-run this wizard when ready"
    exit 1
  fi
fi

# Pooled for the app, direct for migrations. verify-full matches the
# production URLs (see the runbook's sslmode entry).
PREVIEW_DB_URL=$(neon connection-string preview --profile "$NEON_PROFILE" \
  --project-id "$NEON_PROJECT_ID" --pooled --ssl verify-full)
PREVIEW_DIRECT_URL=$(neon connection-string preview --profile "$NEON_PROFILE" \
  --project-id "$NEON_PROJECT_ID" --ssl verify-full)
if [[ "$PREVIEW_DB_URL" != postgres* || "$PREVIEW_DIRECT_URL" != postgres* ]]; then
  warn "couldn't read the 'preview' connection strings — check the '$NEON_PROFILE' profile"
  exit 1
fi
say "Preview pooled connection string (masked): $(_mask_conn "$PREVIEW_DB_URL")"
pause "Continue to the Vercel variables?"

# ── Stage 3: Vercel Preview variables, scoped to dev ──────────────────────
stage "Vercel: Preview variables for the dev branch"
say "Only the dev branch's preview can sign in. Every Preview variable is"
say "scoped to git branch dev, never to Preview as a whole, so other branches'"
say "previews and one-off deployment addresses get none of them."

seed_default VERCEL_PROJECT_NAME "bike-race-results"
ask VERCEL_PROJECT_NAME "Vercel project name:"
write_env VERCEL_PROJECT_NAME "$VERCEL_PROJECT_NAME"

if [[ ! -f .vercel/project.json ]]; then
  # vercel link can offer to pull variables into .env.local, which may be a
  # symlink to the production credential file (see the runbook). A yes would
  # write through it.
  if [[ -L .env.local ]]; then
    warn ".env.local is a symlink, and vercel link could write through it"
    warn "move it aside first (mv .env.local .env.local.aside), re-run, then move it back once linked"
    exit 1
  fi
  say "Linking this checkout to the Vercel project (.vercel is gitignored)."
  step "If vercel offers to pull environment variables, answer No: it writes a token to .env.local."
  vercel link --project "$VERCEL_PROJECT_NAME"
else
  note ".vercel/project.json already linked"
fi

ENV_META=$(_env_meta) || { warn "couldn't list the project's Vercel variables — check vercel login and the link"; exit 1; }

# AUTH_URL is the dev preview's stable branch address, so a magic link returns
# to that deployment. Production's value would send it to production.
step "Vercel dashboard → $VERCEL_PROJECT_NAME → Deployments → the latest from"
step "branch dev → Domains: copy the address with -git-dev- in it."
note "shape: https://$VERCEL_PROJECT_NAME-git-dev-<scope>.vercel.app"
open_url "https://vercel.com/dashboard"
ask PREVIEW_AUTH_URL "Paste the dev preview's address:"
PREVIEW_AUTH_URL="${PREVIEW_AUTH_URL%/}"
if [[ "$PREVIEW_AUTH_URL" == *results.scdescenders.com* ]]; then
  warn "that's Production's address; Preview needs the dev preview's own — re-run"
  exit 1
fi
dev_url_re='^https://[^/]*-git-dev-[^/]*\.vercel\.app$'
if [[ ! "$PREVIEW_AUTH_URL" =~ $dev_url_re ]]; then
  confirm "That doesn't look like a dev branch address. Use it anyway?" || exit 1
fi
write_env PREVIEW_AUTH_URL "$PREVIEW_AUTH_URL"
_want_dev_var AUTH_URL && _add_dev_var AUTH_URL "$PREVIEW_AUTH_URL"

# DATABASE_URL is the preview branch, never production. Replacing it each
# release is harmless and keeps it matched to the branch just reset.
_want_dev_var DATABASE_URL && _add_dev_var DATABASE_URL "$PREVIEW_DB_URL" --sensitive

# AUTH_SECRET is Preview's own, generated here and piped straight to Vercel.
# Never Production's. Replacing it signs everyone out of the dev preview.
_want_dev_var AUTH_SECRET && _add_dev_var AUTH_SECRET "$(openssl rand -base64 32)" --sensitive

# AUTH_EMAIL_SERVER reuses Production's value: the Resend key is shared, so
# rotating it means updating both scopes. Vercel stores Production's as
# sensitive and can't hand it back, so the operator pastes it, hidden.
if _want_dev_var AUTH_EMAIL_SERVER; then
  say "Paste Production's AUTH_EMAIL_SERVER from wherever you saved it."
  note "shape: smtps://resend:<key>@smtp.resend.com:465 (the scheme, not the port, sets TLS)"
  ask_secret EMAIL_SERVER_VALUE "AUTH_EMAIL_SERVER (hidden):"
  if [[ "$EMAIL_SERVER_VALUE" == smtps://* ]]; then
    _add_dev_var AUTH_EMAIL_SERVER "$EMAIL_SERVER_VALUE" --sensitive
  else
    warn "expected an smtps:// URL, so AUTH_EMAIL_SERVER wasn't set"
    SKIPPED+=("Vercel AUTH_EMAIL_SERVER on Preview for dev (vercel env add AUTH_EMAIL_SERVER preview dev --sensitive)")
  fi
  unset EMAIL_SERVER_VALUE
fi

# AUTH_EMAIL_FROM and CURRENT_SEASON match Production's non-secret values.
seed_default AUTH_EMAIL_FROM "Descenders Race Dashboard <results@send.scdescenders.com>"
seed_default CURRENT_SEASON "$(date +%Y)"
for name in AUTH_EMAIL_FROM CURRENT_SEASON; do
  _want_dev_var "$name" || continue
  ask "$name" "Value for $name (match Production's):"
  write_env "$name" "${!name}"
  _add_dev_var "$name" "${!name}"
done

# A Preview-wide copy reaches every branch's preview. The stopped run on
# 2026-09-11 left four: DATABASE_URL, AUTH_URL, AUTH_EMAIL_FROM, CURRENT_SEASON.
# Only a record for Preview alone is removed here. One shared with Production
# or Development is left to the dashboard, since vercel env rm takes it off all.
ENV_META=$(_env_meta) || { warn "couldn't re-list the Vercel variables"; exit 1; }
for name in "${PREVIEW_ENV_NAMES[@]}"; do
  shared=$(_shared_targets "$name")
  if [[ -n "$shared" ]]; then
    warn "$name is set on Preview together with other environments ($shared)"
    step "Vercel dashboard → $VERCEL_PROJECT_NAME → Settings → Environment Variables:"
    step "edit $name and untick Preview. Removing it here would delete it everywhere."
    SKIPPED+=("$name on Preview with $shared: untick Preview in the Vercel dashboard")
  fi
  _has_env "$name" "" || continue
  warn "$name is set on Preview as a whole, so every branch's preview gets it"
  if confirm "Remove the Preview-wide $name?"; then
    step "If vercel asks which one, pick Preview, not Preview (dev)."
    if vercel env rm "$name" preview; then
      VERCEL_CHANGED=true
    else
      SKIPPED+=("Preview-wide $name (vercel env rm $name preview)")
    fi
  else
    SKIPPED+=("Preview-wide $name (vercel env rm $name preview)")
  fi
done

ENV_META=$(_env_meta) || { warn "couldn't re-list the Vercel variables"; exit 1; }
say "Preview variables now:"
for name in "${PREVIEW_ENV_NAMES[@]}"; do
  if _has_env "$name" dev; then scope="dev"; else scope="MISSING on dev"; fi
  _has_env "$name" "" && scope="$scope, still Preview-wide"
  shared=$(_shared_targets "$name")
  [[ -n "$shared" ]] && scope="$scope, still on Preview with $shared"
  note "  $name: $scope"
done
# The wizard never sets AUTH_DEV_LOGIN; this only catches one set by hand.
if jq -e '.[] | select(.key == "AUTH_DEV_LOGIN")' <<<"$ENV_META" >/dev/null 2>&1; then
  warn "AUTH_DEV_LOGIN is set on a hosted scope. It must be absent everywhere."
  SKIPPED+=("remove AUTH_DEV_LOGIN from every hosted scope (vercel env rm AUTH_DEV_LOGIN)")
fi
pause "Continue to the preview migration?"

# ── Stage 4: migrate preview ──────────────────────────────────────────────
stage "Migrate the preview branch"
say "Migrations land on 'preview' before production, and before UAT. The"
say "wizard runs them on the direct URL itself, so it never reaches the screen."

HAS_DB_STATUS=false
jq -e '.scripts["db:status"]' package.json >/dev/null 2>&1 && HAS_DB_STATUS=true

if $HAS_DB_STATUS; then
  say "Journal check before migrating:"
  DATABASE_URL="$PREVIEW_DIRECT_URL" pnpm db:status || true
else
  note "db:status hasn't landed yet (#173), so there's no journal check"
fi

if ! confirm "Migrate 'preview' now?"; then
  warn "UAT needs the migrated schema — re-run this wizard when ready"
  exit 1
fi
if ! DATABASE_URL="$PREVIEW_DIRECT_URL" pnpm db:migrate; then
  warn "the preview migration failed. Stop here and fix it before UAT."
  exit 1
fi
PREVIEW_MIGRATED="yes; db:status unavailable until #173"

if $HAS_DB_STATUS; then
  say "Journal check after migrating:"
  if DATABASE_URL="$PREVIEW_DIRECT_URL" pnpm db:status; then
    PREVIEW_MIGRATED="yes; db:status at head"
  else
    PREVIEW_MIGRATED="yes; db:status NOT at head"
    _record_uat_gap "preview isn't at the migration journal's head after db:migrate"
  fi
fi
pause "Continue to UAT?"

# ── Stage 5: UAT on the dev preview ───────────────────────────────────────
stage "UAT on the dev preview"
SEASON=$(_existing CURRENT_SEASON || date +%Y)

if $VERCEL_CHANGED; then
  say "Variables changed this run, and a deployment reads them only when built."
  step "Vercel dashboard → $VERCEL_PROJECT_NAME → Deployments → the latest from"
  step "branch dev → ⋯ → Redeploy. Wait for Ready."
  pause "Redeployed and Ready?"
fi

step "Use one browser window throughout. Vercel Authentication and the app's"
step "session both live there, so open each magic link in it too."
step "Start at /signin, which avoids #183."
open_url "$PREVIEW_AUTH_URL/signin"
step "Pass Vercel Authentication if asked, then request a magic link for"
step "admin@scdescenders.com. Check spam: first links often land there."
pause "Signed in as admin?"
_uat_check "Admin: real Season data" "Does /$SEASON show real Season data, not an empty state?"
_uat_check "Admin: Club accounts visible" "Open /$SEASON/operations. Is Club accounts visible?"

say "Now the coach UAT user. Its coach membership comes from #182's owner step."
if confirm "Has the coach membership been granted yet?"; then
  step "Sign out, then request a magic link for the coach UAT address."
  open_url "$PREVIEW_AUTH_URL/signin"
  pause "Signed in as the coach?"
  _uat_check "Coach: the same Season data" "Does /$SEASON show the same Season data?"
  _uat_check "Coach: stories open" "Open /$SEASON/stories, then any story. Does it open?"
  _uat_check "Coach: Club accounts absent" "Is Club accounts absent, including on /$SEASON/operations?"
  _uat_check "Coach: Approve and Publish absent" "On an open story, are Approve and Publish absent?"
else
  UAT_LINES+=("- skipped: coach half, no coach membership yet (#182)")
  note "coach half skipped and recorded; it doesn't block this release"
fi

ask UAT_NOTE "Any other gap to record against this release? (Enter for none)"
[[ -n "$UAT_NOTE" ]] && _record_uat_gap "$UAT_NOTE"

# ── Stage 6: migrate production, then promote dev → main ──────────────────
stage "Production: migrate, then promote dev → main"
say "Owner steps. The wizard only prints each production command and waits;"
say "run each one yourself."

NEON_DIRECT_ENV="$HOME/.config/scdescenders/neon-direct.env"
if (( UAT_GAPS )); then
  warn "UAT recorded $UAT_GAPS gap(s). Go on only if you accept them for this release."
  if ! confirm "Continue to production anyway?"; then
    _print_uat_record
    exit 1
  fi
fi
[[ -f "$NEON_DIRECT_ENV" ]] || warn "$NEON_DIRECT_ENV not found — locate the production direct URL before continuing"

step "1. Check production against the migration journal:"
if $HAS_DB_STATUS; then
  say "     ( set -a; . $NEON_DIRECT_ENV; set +a; pnpm db:status )"
else
  note "     db:status hasn't landed yet (#173) — skip this check for now"
fi
pause "Ran it?"

step "2. Migrate production:"
say "     ( set -a; . $NEON_DIRECT_ENV; set +a; pnpm db:migrate )"
note "     set -a exports the file's DATABASE_URL; without it bin/env.ts falls back to .env.local"
warn "this writes to the production database — only after preview UAT passed"
pause "Ran it and it succeeded?"

step "3. Promote dev → main: open the release PR from dev into main, paste the"
step "   UAT record below into it, and merge it."
_print_uat_record
pause "Promoted?"

finish
_print_uat_record
